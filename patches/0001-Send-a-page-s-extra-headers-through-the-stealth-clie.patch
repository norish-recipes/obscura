diff --git a/crates/obscura-net/src/header_scope.rs b/crates/obscura-net/src/header_scope.rs
new file mode 100644
index 0000000..f92e778
--- /dev/null
+++ b/crates/obscura-net/src/header_scope.rs
@@ -0,0 +1,133 @@
+//! Fork-only: extra headers scoped to one domain.
+//!
+//! `Network.setExtraHTTPHeaders` adds its headers to every request a page makes, so a site's
+//! credentials reach every third-party script it loads and wherever a redirect points. With a
+//! scope, a request whose host is not on that domain carries none of them; every redirect hop is
+//! checked on its own URL. Kept out of the clients so an upstream rewrite of them rebases cleanly.
+
+use std::collections::HashMap;
+
+use tokio::sync::RwLock;
+use url::Url;
+
+use crate::cookies::domain_matches;
+
+/// The extra headers a request to `url` carries: all of them, or none when `url` is off `scope`.
+pub(crate) async fn extra_headers_for(
+    headers: &RwLock<HashMap<String, String>>,
+    scope: &RwLock<Option<String>>,
+    url: &Url,
+) -> HashMap<String, String> {
+    if let Some(domain) = scope.read().await.as_deref() {
+        if !url.host_str().is_some_and(|host| domain_matches(host, domain)) {
+            return HashMap::new();
+        }
+    }
+    headers.read().await.clone()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    use super::*;
+    use crate::{CookieJar, ObscuraHttpClient};
+
+    const HEADER: (&str, &str) = ("x-norish-token", "secret");
+
+    async fn headers_for(scope: Option<&str>, url: &str) -> HashMap<String, String> {
+        let headers = RwLock::new(HashMap::from([(HEADER.0.to_string(), HEADER.1.to_string())]));
+        let scope = RwLock::new(scope.map(str::to_string));
+        extra_headers_for(&headers, &scope, &Url::parse(url).unwrap()).await
+    }
+
+    #[tokio::test]
+    async fn unscoped_headers_go_everywhere_as_upstream() {
+        assert_eq!(headers_for(None, "https://other.test/").await.len(), 1);
+    }
+
+    #[tokio::test]
+    async fn scoped_headers_reach_the_domain_and_its_subdomains_only() {
+        assert_eq!(headers_for(Some("example.com"), "https://example.com/a").await.len(), 1);
+        assert_eq!(headers_for(Some("example.com"), "https://www.example.com/a").await.len(), 1);
+        assert!(headers_for(Some("example.com"), "https://notexample.com/").await.is_empty());
+        assert!(headers_for(Some("example.com"), "https://example.com.evil.test/").await.is_empty());
+        assert!(headers_for(Some("example.com"), "data:text/html,hi").await.is_empty());
+    }
+
+    /// A proxy that answers the first request with a redirect to `other.test` and the second with
+    /// 200, and hands back both request heads.
+    async fn redirecting_proxy() -> (String, tokio::task::JoinHandle<Vec<String>>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let proxy = format!("http://{}", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move {
+            let mut heads = Vec::new();
+            for answer in [
+                "HTTP/1.1 302 Found\r\nlocation: http://other.test/b\r\ncontent-length: 0\r\nconnection: close\r\n\r\n",
+                "HTTP/1.1 200 OK\r\ncontent-length: 2\r\nconnection: close\r\n\r\nok",
+            ] {
+                let (mut stream, _) = tokio::time::timeout(Duration::from_secs(5), listener.accept())
+                    .await
+                    .expect("request reaches the proxy")
+                    .unwrap();
+                let mut head = Vec::new();
+                while !head.windows(4).any(|bytes| bytes == b"\r\n\r\n") {
+                    let mut buffer = [0u8; 1024];
+                    let count = stream.read(&mut buffer).await.unwrap();
+                    assert_ne!(count, 0);
+                    head.extend_from_slice(&buffer[..count]);
+                }
+                heads.push(String::from_utf8(head).unwrap().to_ascii_lowercase());
+                stream.write_all(answer.as_bytes()).await.unwrap();
+            }
+            heads
+        });
+        (proxy, server)
+    }
+
+    fn assert_first_hop_only(heads: &[String]) {
+        assert!(heads[0].starts_with("get http://sub.example.com/a"), "{}", heads[0]);
+        assert!(heads[0].contains("x-norish-token: secret"), "{}", heads[0]);
+        assert!(heads[1].starts_with("get http://other.test/b"), "{}", heads[1]);
+        assert!(!heads[1].contains("x-norish-token"), "{}", heads[1]);
+    }
+
+    fn scoped_header() -> (HashMap<String, String>, Option<String>) {
+        (
+            HashMap::from([(HEADER.0.to_string(), HEADER.1.to_string())]),
+            Some("example.com".to_string()),
+        )
+    }
+
+    #[tokio::test]
+    async fn plain_client_drops_scoped_headers_on_an_off_site_redirect() {
+        let (proxy, server) = redirecting_proxy().await;
+        let client =
+            ObscuraHttpClient::with_full_options(Arc::new(CookieJar::new()), Some(&proxy), true);
+        let (headers, scope) = scoped_header();
+
+        client.set_extra_headers_scoped(headers, scope).await;
+        let response = client.fetch(&Url::parse("http://sub.example.com/a").unwrap()).await.unwrap();
+
+        assert_eq!(response.status, 200);
+        assert_first_hop_only(&server.await.unwrap());
+    }
+
+    #[cfg(feature = "stealth")]
+    #[tokio::test]
+    async fn stealth_client_sends_scoped_headers_and_drops_them_off_site() {
+        let (proxy, server) = redirecting_proxy().await;
+        let client =
+            crate::StealthHttpClient::with_proxy(Arc::new(CookieJar::new()), Some(&proxy), true);
+        let (headers, scope) = scoped_header();
+
+        client.set_extra_headers_scoped(headers, scope).await;
+        let response = client.fetch(&Url::parse("http://sub.example.com/a").unwrap()).await.unwrap();
+
+        assert_eq!(response.status, 200);
+        assert_first_hop_only(&server.await.unwrap());
+    }
+}
