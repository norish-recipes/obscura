@@ -0,0 +1,25 @@
+//! Fork-only: a page's extra headers reach both of its HTTP clients, scoped to one domain.
+//!
+//! `Network.setExtraHTTPHeaders` set the context's shared client only, which in a stealth build
+//! sends just external scripts and POST navigations: the document and its other requests go
+//! through the page's own stealth client, which never got the headers. Kept out of `page.rs` so an
+//! upstream rewrite of that file rebases cleanly.
+
+use std::collections::HashMap;
+
+use crate::page::Page;
+
+impl Page {
+    /// Extra headers for every request this page makes, or only those to hosts on `scope`.
+    pub async fn set_extra_headers_scoped(
+        &self,
+        headers: HashMap<String, String>,
+        scope: Option<String>,
+    ) {
+        #[cfg(feature = "stealth")]
+        if let Some(stealth) = &self.stealth_client {
+            stealth.set_extra_headers_scoped(headers.clone(), scope.clone()).await;
+        }
+        self.http_client.set_extra_headers_scoped(headers, scope).await;
+    }
+}
